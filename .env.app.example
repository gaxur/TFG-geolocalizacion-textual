# Copiar como .env.app y revisar cada ruta antes del primer arranque.
# Ajustar las rutas externas que no estén dentro de este checkout.
APP_PROCESSED_DATA_DIR=./data/processed
APP_EMBEDDINGS_DIR=./data/embeddings
APP_EXTERNAL_DIR=./external
APP_CHECKPOINT_DIR=./checkpoints/CrossText2Loc
APP_CLIP_CACHE_DIR=./models/clip
APP_QWEN_MODEL_DIR=./models/Qwen3-8B
APP_MAP_ASSETS_DIR=./data/processed/map-assets
APP_MAP_CONTEXT_DIR=./results/generated/map-assets-context-2000m

APP_API_IMAGE=atlas-app-api:local
APP_FRONTEND_IMAGE=atlas-app-frontend:local
APP_HTTP_PORT=18085
APP_CUDA_VISIBLE_DEVICES=0
APP_API_TMPFS_SIZE=2g
APP_STATE_VOLUME=atlas-app-state

# Fail-closed: el servicio arranca para health/UI, pero la plantilla pendiente
# impide crear sesiones o ejecutar modelos hasta sustituirla por un perfil aprobado.
APP_MODE_ENABLED=true
APP_PROFILE_FILE=./config/freetext_application_profile.template.json
