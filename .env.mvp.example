# El wrapper publica en la LAN por defecto. Usar 127.0.0.1 para limitarlo al host.
MVP_BIND_HOST=0.0.0.0
MVP_HTTP_PORT=8080
MVP_API_CONTAINER_NAME=atlas-mvp-api
MVP_FRONTEND_CONTAINER_NAME=atlas-mvp-frontend

# Imágenes locales. La imagen API debe haberse validado para ARM64 y la GPU GB10.
MVP_API_IMAGE=crosstext2loc-gb10:ngc26.02
MVP_FRONTEND_IMAGE=atlas-mvp-frontend:local
MVP_BROWSER_IMAGE=atlas-mvp-browser-check:local

# Directorio host que contiene ViT-L-14-336px.pt. No se copia a ninguna imagen.
MVP_CLIP_CACHE_DIR=/ruta/al/directorio/.cache/clip

# Fuente cartográfica de desarrollo. Conservar una atribución válida.
VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_TILE_ATTRIBUTION="&copy; OpenStreetMap contributors"
