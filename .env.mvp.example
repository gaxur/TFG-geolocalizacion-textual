# El wrapper publica en la LAN por defecto. Usar 127.0.0.1 para limitarlo al host.
MVP_BIND_HOST=0.0.0.0
MVP_HTTP_PORT=8080
MVP_API_CONTAINER_NAME=atlas-mvp-api
MVP_FRONTEND_CONTAINER_NAME=atlas-mvp-frontend

# Imágenes locales. La imagen API debe haberse validado para ARM64 y la GPU GB10.
MVP_API_IMAGE=crosstext2loc-gb10:f511
MVP_FRONTEND_IMAGE=atlas-mvp-frontend:local
MVP_BROWSER_IMAGE=atlas-mvp-browser-check:local

# Directorio host que contiene ViT-L-14-336px.pt. No se copia a ninguna imagen.
MVP_CLIP_CACHE_DIR=/ruta/al/directorio/.cache/clip

# Snapshot local exacto Qwen3-8B. Se monta en solo lectura; no se descarga.
MVP_QWEN_MODEL_DIR=/ruta/a/models/hf/Qwen3-8B-b968826d9c46

# Postprocesamiento Qwen3-VL precalculado. Si no hay entrada compatible, conserva CT2L.
ATLAS_VISUAL_PROMOTION_ENABLED=false
MVP_VISUAL_BUNDLE_DIR=/ruta/a/bundles-visuales
ATLAS_VISUAL_PRECOMPUTED_BUNDLE_CONTAINER=/visual-bundles/atlas-visual-bundle.json

# Recursos cartográficos locales servidos por el Nginx frontend existente.
# Preparar data/processed/map-assets fuera de `docker compose up`; no se descargan teselas.
MVP_MAP_ASSETS_DIR=./data/processed/map-assets
MVP_MAP_CONTEXT_DIR=./results/generated/map-assets-context-2000m
ATLAS_DIALOGUE_ENABLED=false
ATLAS_DIALOGUE_COMPLETED_QUERY_IDS=H26
MVP_DIALOGUE_COHORT_FILE=/ruta/al/checkout-experimental/results/generated/dialogue-development-h26-h37-v3/cohort.json
MVP_DIALOGUE_AUTHORIZATION_FILE=./config/dialogue_h27_session_authorization.request.json
MVP_DIALOGUE_VARIANTS_FILE=./results/generated/description-length-experiments/manifest.json
MVP_DIALOGUE_SESSION_DIR=./results/generated/mvp-dialogue-sessions
MVP_DIALOGUE_IMAGE_DIR=./data/cache/mapillary/images
MVP_PROCESSED_DATA_DIR=./data/processed
MVP_EMBEDDINGS_DIR=./data/embeddings
MVP_EXTERNAL_DIR=./external
MVP_CHECKPOINT_DIR=./checkpoints/CrossText2Loc
ATLAS_DIALOGUE_F3_BUNDLE_CONTAINER=/workspace/project/data/processed/osm/<snapshot>/<f3-bundle>
ATLAS_OLLAMA_PS_URL=http://host.docker.internal:11434/api/ps
