# Código de terceros: clon local, nunca incorporado al monorepo.
/external/


# Datasets locales. Se conservan README y marcadores, no su contenido.
/data/*
!/data/README.md
!/data/cvg_text/
!/data/madrid/
/data/cvg_text/*
!/data/cvg_text/.gitkeep
/data/madrid/*
!/data/madrid/.gitkeep
/data/raw/
/data/processed/
/data/embeddings/
/data/indexes/
/data/evaluation/generated/

# Checkpoints: únicamente se versiona su documentación.
/checkpoints/*
!/checkpoints/README.md
*.pth
*.pt
*.ckpt
*.safetensors
*.gguf
*.onnx
*.h5
*.bin

# Descargas, serializaciones de datos y archivos comprimidos.
*.zip
*.rar
*.7z
*.tar
*.tar.*
*.parquet
*.arrow
*.npy
*.npz
*.pkl
*.pickle
*.sqlite
*.sqlite3
*.db

# Salidas voluminosas y temporales; los CSV/JSON pequeños siguen permitidos.
/logs/
/results/generated/
/results/raw/
/results/large/
/results/cache/
/results/cross_text2loc_docker/
/results/cross_text2loc_wait_run/
*.log
*.tmp
*.temp
*.bak
*~

# Entornos, cachés Python y herramientas ML.
.venv/
.venv-geo/
venv/
env/
.conda/
__pypackages__/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
htmlcov/
.cache/
.huggingface/
.torch/
wandb/
mlruns/
lightning_logs/

# Frontend y herramientas de desarrollo.
node_modules/
dist/
build/
coverage/
test-results/
playwright-report/
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini

# Configuración privada y credenciales (no excluir JSON/CSV en general).
.env
.env.*
!.env.example
credentials.json
*service-account*.json
*service_account*.json
*secrets*.json
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
