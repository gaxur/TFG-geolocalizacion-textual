{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "f5_ground_truth_dataset.schema.json",
  "title": "F5.4 Madrid observer Ground Truth sidecar",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "dataset_id", "dataset_version", "source_query_dataset", "catalogs", "collection_protocol", "observations"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "contract_version": {"const": "f5-ground-truth-dataset-v1"},
    "dataset_id": {"type": "string", "pattern": "^f5-madrid-ground-truth-sha256-[0-9a-f]{64}$"},
    "dataset_version": {"type": "string", "minLength": 1},
    "source_query_dataset": {"type": "object", "additionalProperties": false, "required": ["dataset_id", "sha256"], "properties": {"dataset_id": {"type": "string", "pattern": "^f4-madrid-queries-sha256-[0-9a-f]{64}$"}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "catalogs": {"type": "object", "additionalProperties": false, "required": ["madrid-25m", "madrid-50m"], "properties": {"madrid-25m": {"$ref": "#/$defs/catalog"}, "madrid-50m": {"$ref": "#/$defs/catalog"}}},
    "collection_protocol": {"type": "object", "additionalProperties": false, "required": ["version", "target_observations", "observer_position_policy", "description_policy", "ground_truth_capture_before_ranking", "evidence_required", "orientation_policy", "synthetic_excluded_from_accuracy"], "properties": {"version": {"const": "f54-madrid-observer-collection-v1"}, "target_observations": {"type": "object", "additionalProperties": false, "required": ["minimum", "maximum"], "properties": {"minimum": {"const": 20}, "maximum": {"const": 30}}}, "observer_position_policy": {"const": "observer_wgs84_not_mentioned_object"}, "description_policy": {"const": "original_spanish_independent_observation"}, "ground_truth_capture_before_ranking": {"const": true}, "evidence_required": {"const": true}, "orientation_policy": {"const": "explicit_evidence_no_egocentric_to_cardinal_inference"}, "synthetic_excluded_from_accuracy": {"const": true}}},
    "observations": {"type": "array", "items": {"$ref": "#/$defs/observation"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "catalog": {"type": "object", "additionalProperties": false, "required": ["manifest_id", "manifest_sha256", "candidate_count", "cell_size_m"], "properties": {"manifest_id": {"type": "string", "minLength": 1}, "manifest_sha256": {"$ref": "#/$defs/sha256"}, "candidate_count": {"type": "integer", "minimum": 1}, "cell_size_m": {"enum": [25, 50]}}},
    "evidence": {"type": "object", "additionalProperties": false, "required": ["evidence_id", "kind", "logical_reference", "sha256", "description", "captured_at_utc", "review_status"], "properties": {"evidence_id": {"type": "string", "minLength": 1}, "kind": {"enum": ["gnss_record", "field_note", "geotagged_photo_metadata", "survey_record", "existing_dataset_record", "other"]}, "logical_reference": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}, "description": {"type": "string", "minLength": 1}, "captured_at_utc": {"type": "string", "minLength": 1}, "review_status": {"enum": ["pending", "reviewed", "rejected"]}}},
    "assignment": {"type": "object", "additionalProperties": false, "required": ["status", "center_distance_m", "distance_to_cell_boundary_m", "boundary_ambiguous"], "properties": {"status": {"enum": ["assigned", "outside_region", "outside_catalog_coverage", "boundary_ambiguous", "accuracy_insufficient"]}, "candidate_id": {"type": ["string", "null"]}, "candidate_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "center_distance_m": {"type": ["number", "null"], "minimum": 0}, "distance_to_cell_boundary_m": {"type": ["number", "null"], "minimum": 0}, "boundary_ambiguous": {"type": "boolean"}}},
    "orientation": {"type": "object", "additionalProperties": false, "required": ["status", "cardinal", "bearing_degrees", "uncertainty_degrees", "verification_method", "evidence_ids", "egocentric_relations_present", "notes"], "properties": {"status": {"enum": ["absent", "reported", "verified"]}, "cardinal": {"enum": ["north", "northeast", "east", "southeast", "south", "southwest", "west", "northwest", null]}, "bearing_degrees": {"type": ["number", "null"], "minimum": 0, "exclusiveMaximum": 360}, "uncertainty_degrees": {"type": ["number", "null"], "minimum": 0, "maximum": 180}, "verification_method": {"type": ["string", "null"]}, "evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "egocentric_relations_present": {"type": "boolean"}, "notes": {"type": ["string", "null"]}}},
    "reference": {"type": "object", "additionalProperties": false, "required": ["status", "latitude", "longitude", "crs", "capture_method", "reported_accuracy_m", "validation_method", "evidence", "review_notes"], "properties": {"status": {"enum": ["pending", "validated", "rejected"]}, "latitude": {"type": ["number", "null"], "minimum": -90, "maximum": 90}, "longitude": {"type": ["number", "null"], "minimum": -180, "maximum": 180}, "crs": {"enum": ["EPSG:4326", null]}, "capture_method": {"type": ["string", "null"]}, "reported_accuracy_m": {"type": ["number", "null"], "minimum": 0}, "validation_method": {"type": ["string", "null"]}, "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}, "review_notes": {"type": ["string", "null"]}}},
    "observation": {"type": "object", "additionalProperties": false, "required": ["source_query_id", "location_id", "derivation_group_id", "partition", "description_profile", "comparison_parent_query_id", "observer_reference", "orientation", "catalog_assignments", "description_review_status", "limitations"], "properties": {"source_query_id": {"type": "string", "minLength": 1}, "location_id": {"type": ["string", "null"], "minLength": 1}, "derivation_group_id": {"type": "string", "minLength": 1}, "partition": {"enum": ["development", "evaluation"]}, "description_profile": {"enum": ["complete_observation", "controlled_simplification"]}, "comparison_parent_query_id": {"type": ["string", "null"], "minLength": 1}, "observer_reference": {"$ref": "#/$defs/reference"}, "orientation": {"$ref": "#/$defs/orientation"}, "catalog_assignments": {"type": "object", "additionalProperties": false, "required": ["madrid-25m", "madrid-50m"], "properties": {"madrid-25m": {"oneOf": [{"$ref": "#/$defs/assignment"}, {"type": "null"}]}, "madrid-50m": {"oneOf": [{"$ref": "#/$defs/assignment"}, {"type": "null"}]}}}, "description_review_status": {"enum": ["pending", "reviewed", "rejected"]}, "limitations": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}}
  }
}
