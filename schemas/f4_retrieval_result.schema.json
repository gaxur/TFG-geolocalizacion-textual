{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "f4_retrieval_result.schema.json",
  "title": "F4 exhaustive text retrieval result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "query", "embedding_dataset_id", "ranking_method", "requested_k", "results", "timings_ms"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "contract_version": {"const": "f4-exhaustive-retrieval-v1"},
    "query": {
      "type": "object", "additionalProperties": false,
      "required": ["query_id", "text", "language"],
      "properties": {"query_id": {"type": "string", "minLength": 1}, "text": {"type": "string", "minLength": 1}, "language": {"type": "string", "minLength": 2}}
    },
    "embedding_dataset_id": {"type": "string", "pattern": "^f4-madrid-embeddings-sha256-[0-9a-f]{64}$"},
    "ranking_method": {"const": "exhaustive_cosine"},
    "requested_k": {"type": "integer", "minimum": 1},
    "results": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["rank", "candidate_id", "latitude", "longitude", "score"],
        "properties": {"rank": {"type": "integer", "minimum": 1}, "candidate_id": {"type": "string", "minLength": 1}, "latitude": {"type": "number", "minimum": -90, "maximum": 90}, "longitude": {"type": "number", "minimum": -180, "maximum": 180}, "score": {"type": "number", "minimum": -1, "maximum": 1}}
      }
    },
    "timings_ms": {
      "type": "object", "additionalProperties": false,
      "required": ["text_encoding", "ranking", "total"],
      "properties": {"text_encoding": {"type": "number", "minimum": 0}, "ranking": {"type": "number", "minimum": 0}, "total": {"type": "number", "minimum": 0}}
    }
  }
}
