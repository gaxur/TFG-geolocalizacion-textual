{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dialogue_visual_evidence.schema.json",
  "title": "Evidencia visual acotada a una imagen y una intención de diálogo",
  "type": "object",
  "additionalProperties": false,
  "required": ["evidence_id", "contract_version", "session_id", "turn_index", "intent_id", "intent_family", "question_sha256", "input_ranking_sha256", "claim", "image", "provider", "state", "observed_evidence", "raw_output", "abstention_reason", "limitations", "scope", "query_update_allowed", "ranking_update_allowed", "recorded_at_utc"],
  "properties": {
    "evidence_id": {"type": "string", "pattern": "^dialogue-visual-evidence-sha256-[0-9a-f]{64}$"},
    "contract_version": {"const": "dialogue-visual-evidence-v1"},
    "session_id": {"type": "string", "minLength": 1},
    "turn_index": {"type": "integer", "minimum": 1, "maximum": 3},
    "intent_id": {"type": "string", "minLength": 1},
    "intent_family": {"enum": ["square", "church", "monument", "intersection", "park", "commercial"]},
    "question_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "input_ranking_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "claim": {"type": "object", "required": ["claim_id", "kind", "value", "source_intent_id"]},
    "image": {"type": "object", "additionalProperties": false, "required": ["image_id", "sha256", "logical_path", "provenance", "authorized", "authorization_id", "observer_relation"], "properties": {"image_id": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "logical_path": {"type": "string"}, "provenance": {"type": "object", "required": ["source"], "properties": {"source": {"type": "string", "minLength": 1}}}, "authorized": {"type": "boolean"}, "authorization_id": {"type": ["string", "null"]}, "observer_relation": {"type": "string"}}},
    "provider": {"type": "object", "required": ["model_id", "revision"]},
    "state": {"enum": ["supported", "contradicted", "unverifiable"]},
    "observed_evidence": {"type": ["string", "null"]},
    "raw_output": {"type": ["string", "null"]},
    "abstention_reason": {"type": ["string", "null"]},
    "limitations": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "scope": {"const": "image_pixels_only_not_geographic_truth"},
    "query_update_allowed": {"const": false},
    "ranking_update_allowed": {"const": false},
    "recorded_at_utc": {"type": "string"}
  },
  "allOf": [
    {"if": {"properties": {"state": {"enum": ["supported", "contradicted"]}}}, "then": {"properties": {"observed_evidence": {"type": "string", "pattern": "\\S"}, "image": {"properties": {"authorized": {"const": true}, "authorization_id": {"type": "string", "minLength": 1}, "observer_relation": {"const": "observer_view"}, "provenance": {"properties": {"source": {"type": "string", "minLength": 1}}}}}}}},
    {"if": {"properties": {"state": {"const": "unverifiable"}}}, "then": {"properties": {"abstention_reason": {"type": "string", "minLength": 1}}}}
  ]
}
