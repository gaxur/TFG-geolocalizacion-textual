{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "manifest.schema.json",
  "title": "Reference catalog manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "region_id", "catalog_version", "osm_snapshot_id", "generation", "provenance", "candidates"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "manifest_id": {"type": "string", "minLength": 1},
    "region_id": {"type": "string", "minLength": 1},
    "catalog_version": {"type": "string", "minLength": 1},
    "osm_snapshot_id": {"type": ["string", "null"]},
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["region_bbox_wgs84", "source_crs", "projected_crs", "spacing_m", "cell_size_m", "border_policy", "order", "grid_hash", "generator_version"],
      "properties": {
        "region_bbox_wgs84": {
          "type": "object",
          "additionalProperties": false,
          "required": ["north", "south", "east", "west"],
          "properties": {
            "north": {"type": "number", "minimum": -90, "maximum": 90},
            "south": {"type": "number", "minimum": -90, "maximum": 90},
            "east": {"type": "number", "minimum": -180, "maximum": 180},
            "west": {"type": "number", "minimum": -180, "maximum": 180}
          }
        },
        "source_crs": {"const": "EPSG:4326"},
        "projected_crs": {"const": "EPSG:25830"},
        "spacing_m": {"type": "integer", "minimum": 1},
        "cell_size_m": {"type": "integer", "minimum": 1},
        "border_policy": {"const": "full_cell_within_bbox"},
        "order": {"const": "row_south_to_north_then_column_west_to_east"},
        "grid_hash": {"type": "string", "pattern": "^[0-9a-f]{12}$"},
        "generator_version": {"const": "phase1-grid-v1"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "artifact_id", "source", "source_version", "input_hashes", "parameters_hash", "code_version"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "artifact_id": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "source_version": {"type": ["string", "null"]},
        "input_hashes": {"type": "object"},
        "parameters_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "code_version": {"type": ["string", "null"]}
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate_id", "latitude", "longitude", "cell_geometry", "artifacts", "generation"],
        "properties": {
          "candidate_id": {"type": "string", "minLength": 1},
          "latitude": {"type": "number", "minimum": -90, "maximum": 90},
          "longitude": {"type": "number", "minimum": -180, "maximum": 180},
          "cell_geometry": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "coordinates"],
            "properties": {
              "type": {"const": "Polygon"},
              "coordinates": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1,
                "items": {
                  "type": "array",
                  "minItems": 5,
                  "maxItems": 5,
                  "items": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "prefixItems": [
                      {"type": "number", "minimum": -180, "maximum": 180},
                      {"type": "number", "minimum": -90, "maximum": 90}
                    ]
                  }
                }
              }
            }
          },
          "artifacts": {
            "type": "object",
            "additionalProperties": false,
            "required": ["osm_image", "osm_embedding", "satellite_image", "satellite_embedding", "scene_id", "scene_graph", "scene_embedding"],
            "properties": {
              "osm_image": {"type": ["string", "null"]},
              "osm_embedding": {"type": ["string", "null"]},
              "satellite_image": {"type": ["string", "null"]},
              "satellite_embedding": {"type": ["string", "null"]},
              "scene_id": {"type": ["string", "null"]},
              "scene_graph": {"type": ["string", "null"]},
              "scene_embedding": {"type": ["string", "null"]}
            }
          },
          "generation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["row", "column", "center_easting_m", "center_northing_m"],
            "properties": {
              "row": {"type": "integer", "minimum": 0},
              "column": {"type": "integer", "minimum": 0},
              "center_easting_m": {"type": "number"},
              "center_northing_m": {"type": "number"}
            }
          }
        }
      }
    }
  }
}
