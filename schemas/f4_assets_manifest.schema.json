{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "f4_assets_manifest.schema.json",
  "title": "F4 renderer assets and fonts manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "kind", "files"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "manifest_id": {"type": "string", "minLength": 1},
    "kind": {"enum": ["renderer_assets", "fonts"]},
    "files": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["logical_path", "sha256", "size_bytes", "source", "license"],
        "properties": {
          "logical_path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!.*(?:^|[\\\\/])\\.{1,2}(?:[\\\\/]|$)).+$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size_bytes": {"type": "integer", "minimum": 1},
          "source": {"type": "string", "minLength": 1},
          "license": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
