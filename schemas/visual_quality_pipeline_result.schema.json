{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "visual_quality_pipeline_result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "run_id", "mode", "policy", "protocol", "candidates", "attempts", "summary", "resources"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "contract_version": {"const": "visual-quality-replacement-result-v1"},
    "run_id": {"pattern": "^visual-quality-run-sha256-[0-9a-f]{64}$"},
    "mode": {"enum": ["offline", "online", "fixture"]},
    "policy": {"type": "object"},
    "protocol": {"type": "object"},
    "candidates": {"type": "array"},
    "attempts": {"type": "array"},
    "summary": {"type": "object"},
    "resources": {"type": "object"}
  }
}
