{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "llm_geo_query.schema.json",
  "title": "Provider-independent geographic query intent",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "query_id", "input", "region", "objects", "relations", "visual_clues", "unparsed_clues", "warnings"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "query_id": {"type": "string", "minLength": 1},
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "language"],
      "properties": {
        "text": {"type": "string", "minLength": 1},
        "language": {"type": "string", "minLength": 2}
      }
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source", "catalog_region_id", "name", "bbox", "center_radius", "confidence"],
      "properties": {
        "kind": {"enum": ["catalog_region", "bbox", "center_radius", "named_area"]},
        "source": {"enum": ["user", "configuration", "inferred"]},
        "catalog_region_id": {"type": ["string", "null"]},
        "name": {"type": ["string", "null"]},
        "bbox": {"type": ["object", "null"]},
        "center_radius": {"type": ["object", "null"]},
        "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
      }
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "mention", "canonical_type", "name", "negated", "certainty", "confidence", "attributes"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "mention": {"type": "string", "minLength": 1},
          "canonical_type": {"type": "string", "minLength": 1},
          "name": {"type": ["string", "null"]},
          "negated": {"type": "boolean"},
          "certainty": {"enum": ["explicit", "inferred", "uncertain"]},
          "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "attributes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["key", "value", "channel", "certainty", "confidence"],
              "properties": {
                "key": {"type": "string", "minLength": 1},
                "value": {},
                "channel": {"enum": ["semantic", "textual", "visual"]},
                "certainty": {"enum": ["explicit", "inferred", "uncertain"]},
                "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
              }
            }
          }
        }
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "subject_id", "predicate", "object_ids", "distance", "orientation", "certainty", "confidence"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "subject_id": {"type": "string", "minLength": 1},
          "predicate": {"enum": ["near", "inside", "intersects", "adjacent", "across_from", "left_of", "right_of", "in_front_of", "behind", "north_of", "south_of", "east_of", "west_of", "along", "between"]},
          "object_ids": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"type": "string", "minLength": 1}},
          "distance": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["qualifier", "label", "min_m", "max_m"],
            "properties": {
              "qualifier": {"enum": ["exact", "approximate", "at_most", "at_least", "qualitative"]},
              "label": {"type": ["string", "null"]},
              "min_m": {"type": ["number", "null"], "minimum": 0},
              "max_m": {"type": ["number", "null"], "minimum": 0}
            }
          },
          "orientation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["frame", "direction", "known"],
            "properties": {
              "frame": {"enum": ["cardinal", "egocentric", "unknown"]},
              "direction": {"type": ["string", "null"]},
              "known": {"type": "boolean"}
            }
          },
          "certainty": {"enum": ["explicit", "inferred", "uncertain"]},
          "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
        }
      }
    },
    "visual_clues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["mention", "category", "linked_object_ids", "confidence"],
        "properties": {
          "mention": {"type": "string", "minLength": 1},
          "category": {"type": "string", "minLength": 1},
          "linked_object_ids": {"type": "array", "items": {"type": "string"}},
          "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
        }
      }
    },
    "unparsed_clues": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": "string"}}
  }
}
