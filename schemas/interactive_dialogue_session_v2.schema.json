{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "interactive_dialogue_session_v2.schema.json",
  "title": "Adaptive multi-turn geolocation session without ground truth",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "session_id", "status", "max_questions", "questions_asked", "gallery_id", "policy", "models", "inputs", "f3", "initial_query", "initial_ranking", "current_ranking", "claims", "turns", "stop_reason", "events", "limitations"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "contract_version": {"const": "interactive-dialogue-session-v2"},
    "session_id": {"type": "string", "pattern": "^dialogue-session-v2-sha256-[0-9a-f]{64}$"},
    "status": {"enum": ["awaiting_answer", "completed"]},
    "max_questions": {"type": "integer", "minimum": 1, "maximum": 3},
    "questions_asked": {"type": "integer", "minimum": 0, "maximum": 3},
    "gallery_id": {"type": "string", "minLength": 1},
    "policy": {"$ref": "#/$defs/safeObject"},
    "models": {"$ref": "#/$defs/safeObject"},
    "inputs": {"$ref": "#/$defs/safeObject"},
    "f3": {"$ref": "#/$defs/safeObject"},
    "initial_query": {"$ref": "#/$defs/safeObject"},
    "initial_ranking": {"$ref": "#/$defs/ranking"},
    "current_ranking": {"$ref": "#/$defs/ranking"},
    "claims": {"type": "array", "items": {"$ref": "#/$defs/claim"}},
    "turns": {"type": "array", "maxItems": 3, "items": {"$ref": "#/$defs/turn"}},
    "stop_reason": {"type": ["string", "null"]},
    "events": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/safeObject"}},
    "limitations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
  },
  "$defs": {
    "ranking": {
      "type": "object",
      "required": ["gallery_id", "gallery_count", "effective_k", "ranking_method", "tie_break", "results"],
      "properties": {"gallery_id": {"type": "string"}, "gallery_count": {"type": "integer", "minimum": 1}, "effective_k": {"type": "integer", "minimum": 1}, "ranking_method": {"const": "exhaustive_cosine"}, "tie_break": {"const": "candidate_id_ascending"}, "results": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/safeObject"}}},
      "additionalProperties": {"$ref": "#/$defs/safeValue"}
    },
    "claim": {
      "type": "object",
      "required": ["claim_id", "turn_index", "feature", "label", "polarity", "clarification", "answer_literal", "active", "supersedes"],
      "properties": {"claim_id": {"type": "string"}, "turn_index": {"type": "integer", "minimum": 1, "maximum": 3}, "feature": {"type": "string"}, "label": {"type": "string"}, "polarity": {"enum": ["positive", "negative"]}, "clarification": {"type": "string"}, "answer_literal": {"type": "string"}, "active": {"type": "boolean"}, "supersedes": {"type": ["string", "null"]}},
      "additionalProperties": false
    },
    "turn": {
      "type": "object",
      "required": ["index", "input_ranking", "input_ranking_sha256", "hypotheses", "f3_evidence_considered", "question", "answer", "conflict_resolution", "canonical_query", "query_updates", "posterior_ranking", "comparison", "continuation_reason", "runtime_error"],
      "properties": {"index": {"type": "integer", "minimum": 1, "maximum": 3}, "input_ranking": {"$ref": "#/$defs/ranking"}, "input_ranking_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "hypotheses": {"type": "array", "items": {"$ref": "#/$defs/safeObject"}}, "f3_evidence_considered": {"type": "array", "items": {"type": "string"}}, "question": {"$ref": "#/$defs/safeObject"}, "answer": {"anyOf": [{"$ref": "#/$defs/safeObject"}, {"type": "null"}]}, "conflict_resolution": {"anyOf": [{"$ref": "#/$defs/safeObject"}, {"type": "null"}]}, "canonical_query": {"anyOf": [{"$ref": "#/$defs/safeObject"}, {"type": "null"}]}, "query_updates": {"type": "array", "items": {"$ref": "#/$defs/safeObject"}}, "posterior_ranking": {"anyOf": [{"$ref": "#/$defs/ranking"}, {"type": "null"}]}, "comparison": {"anyOf": [{"$ref": "#/$defs/safeObject"}, {"type": "null"}]}, "continuation_reason": {"type": ["string", "null"]}, "runtime_error": {"type": ["string", "null"]}},
      "additionalProperties": false
    },
    "safeObject": {
      "type": "object",
      "propertyNames": {"not": {"enum": ["ground_truth", "ground_truth_candidate", "target_candidate_id", "reference_coordinate", "correct_candidate", "gt"]}},
      "additionalProperties": {"$ref": "#/$defs/safeValue"}
    },
    "safeValue": {
      "anyOf": [
        {"type": ["string", "number", "integer", "boolean", "null"]},
        {"$ref": "#/$defs/safeObject"},
        {"type": "array", "items": {"$ref": "#/$defs/safeValue"}}
      ]
    }
  }
}
