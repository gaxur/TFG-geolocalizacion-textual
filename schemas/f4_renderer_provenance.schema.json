{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "f4_renderer_provenance.schema.json",
  "title": "F4 renderer and style provenance",
  "type": "object",
  "additionalProperties": false,
  "required": ["renderer", "style"],
  "properties": {
    "renderer": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_version", "renderer_id", "name", "version", "configuration_path", "configuration_sha256", "container_image_digest", "license"],
      "properties": {
        "contract_version": {"const": "f4-renderer-provenance-v1"}, "renderer_id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1},
        "configuration_path": {"$ref": "#/$defs/logicalPath"}, "configuration_sha256": {"$ref": "#/$defs/sha256"},
        "container_image_digest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"}, "license": {"type": "string", "minLength": 1}
      }
    },
    "style": {
      "type": "object", "additionalProperties": false,
      "required": ["style_id", "version", "repository_commit", "compiled_style_path", "compiled_style_sha256", "assets_manifest_path", "assets_manifest_sha256", "fonts_manifest_path", "fonts_manifest_sha256", "license"],
      "properties": {
        "style_id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1},
        "repository_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "compiled_style_path": {"$ref": "#/$defs/logicalPath"}, "compiled_style_sha256": {"$ref": "#/$defs/sha256"},
        "assets_manifest_path": {"$ref": "#/$defs/logicalPath"}, "assets_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "fonts_manifest_path": {"$ref": "#/$defs/logicalPath"}, "fonts_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "license": {"type": "string", "minLength": 1}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "logicalPath": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!.*(?:^|[\\\\/])\\.{1,2}(?:[\\\\/]|$)).+$"}
  }
}
