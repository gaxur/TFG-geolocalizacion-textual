{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "i20_blind_ledger_submission.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "protocol", "project_alias", "submission_id", "dataset_release", "policy_id", "created_at_utc", "expires_at_utc", "candidate_count", "candidates", "manifest_commitment", "requester_key_id", "requester_signature"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "contract_version": {"const": "i20-blind-ledger-submission-v1"},
    "protocol": {"const": "blind-exclusion-ledger/v1"},
    "project_alias": {"type": "string", "minLength": 3, "maxLength": 80},
    "submission_id": {"type": "string", "format": "uuid"},
    "dataset_release": {"type": "string", "pattern": "^i20-candidate-release-[0-9]{4}-[0-9]{2}$"},
    "policy_id": {"const": "i20-exclusion-policy-v1"},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "expires_at_utc": {"type": "string", "format": "date-time"},
    "candidate_count": {"type": "integer", "minimum": 12, "maximum": 40},
    "candidates": {
      "type": "array", "minItems": 12, "maxItems": 40,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["candidate_ref", "media_type", "byte_length", "content_commitment", "sequence_ref", "sequence_position"],
        "properties": {
          "candidate_ref": {"type": "string", "format": "uuid"},
          "media_type": {"enum": ["image/jpeg", "image/png"]},
          "byte_length": {"type": "integer", "minimum": 1},
          "content_commitment": {"pattern": "^sha256:[0-9a-f]{64}$"},
          "sequence_ref": {"type": "string", "pattern": "^seq-[0-9a-f]{16}$"},
          "sequence_position": {"type": "integer", "minimum": 0}
        }
      }
    },
    "manifest_commitment": {"pattern": "^sha256:[0-9a-f]{64}$"},
    "requester_key_id": {"type": "string", "minLength": 1, "maxLength": 80},
    "requester_signature": {"pattern": "^ed25519:[A-Za-z0-9+/=]+$"}
  }
}
