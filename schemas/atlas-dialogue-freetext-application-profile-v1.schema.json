{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "atlas-dialogue-freetext-application-profile-v1.schema.json",
  "title": "Reusable FreeText application profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "profile_id", "profile_version", "approval_reference", "status", "approved", "approved_at", "valid_from", "expires_at", "application_policy_id", "application_policy_version", "application_policy_sha256", "core_policy_id", "core_policy_version", "core_policy_sha256", "executor_identity", "executor_identity_sha256", "max_sessions_total", "max_open_sessions", "global_quotas", "per_session_quotas", "constraints"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "contract_version": {"const": "atlas-dialogue-freetext-application-profile-v1"},
    "profile_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "profile_version": {"type": "string", "minLength": 1},
    "approval_reference": {"type": "string", "minLength": 1},
    "status": {"const": "APPROVED"},
    "approved": {"const": true},
    "approved_at": {"type": "string", "format": "date-time"},
    "valid_from": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "application_policy_id": {"const": "dialogue-vpr-freetext-v1-application"},
    "application_policy_version": {"const": "1.0.0"},
    "application_policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "core_policy_id": {"const": "dialogue-vpr-freetext-v1-application-core"},
    "core_policy_version": {"const": "1.0.0"},
    "core_policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "executor_identity": {"type": "object", "minProperties": 1},
    "executor_identity_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "max_sessions_total": {"type": "null"},
    "max_open_sessions": {"const": 1},
    "global_quotas": {"const": {"maximum_qwen_units": null, "maximum_ct2l_units": null, "maximum_questions": null}},
    "per_session_quotas": {"const": {"maximum_qwen_loads": 4, "maximum_qwen_calls": 4, "maximum_ct2l_loads": 4, "maximum_ct2l_calls": 4, "maximum_questions": 3, "automatic_retries": 0}},
    "constraints": {"const": {"access_mode": "loopback", "network_permitted": false, "ground_truth_permitted": false, "references_permitted": false, "vlm_permitted": false, "h38_h61_permitted": false}}
  }
}
