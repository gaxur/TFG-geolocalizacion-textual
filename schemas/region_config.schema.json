{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "region_config.schema.json",
  "title": "TFG region configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "region", "catalog", "osm_acquisition", "artifacts"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "bbox", "crs"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "crs": {"const": "EPSG:4326"},
        "bbox": {
          "type": "object",
          "additionalProperties": false,
          "required": ["north", "south", "east", "west"],
          "properties": {
            "north": {"type": "number", "minimum": -90, "maximum": 90},
            "south": {"type": "number", "minimum": -90, "maximum": 90},
            "east": {"type": "number", "minimum": -180, "maximum": 180},
            "west": {"type": "number", "minimum": -180, "maximum": 180}
          }
        }
      }
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projected_crs", "catalog_version", "candidate_id_prefix", "candidate_spacing_m", "cell_size_m", "candidate_generation", "border_policy"],
      "properties": {
        "projected_crs": {"const": "EPSG:25830"},
        "catalog_version": {"type": "string", "minLength": 1},
        "candidate_id_prefix": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*$"},
        "candidate_spacing_m": {"type": ["integer", "null"], "minimum": 1},
        "cell_size_m": {"type": ["integer", "null"], "minimum": 1},
        "candidate_generation": {"const": "projected_square_grid"},
        "border_policy": {"const": "full_cell_within_bbox"}
      }
    },
    "osm_acquisition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "endpoint", "raw_format", "server_timeout_seconds", "connect_timeout_seconds", "http_total_timeout_seconds", "max_retries", "backoff_seconds", "retry_after_max_seconds", "max_raw_bytes", "acquirer_version", "user_agent"],
      "properties": {
        "provider": {"const": "overpass"},
        "endpoint": {"type": "string", "pattern": "^https://"},
        "raw_format": {"const": "osmxml"},
        "server_timeout_seconds": {"const": 60},
        "connect_timeout_seconds": {"const": 10},
        "http_total_timeout_seconds": {"const": 120},
        "max_retries": {"const": 2},
        "backoff_seconds": {"const": [5, 15]},
        "retry_after_max_seconds": {"const": 60},
        "max_raw_bytes": {"type": "integer", "minimum": 1},
        "acquirer_version": {"const": "phase2-overpass-v1"},
        "user_agent": {"type": "string", "minLength": 1}
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw_osm", "processed_osm", "manifest", "embeddings"],
      "properties": {
        "raw_osm": {"type": "string", "minLength": 1},
        "processed_osm": {"type": "string", "minLength": 1},
        "manifest": {"type": "string", "minLength": 1},
        "embeddings": {"type": "string", "minLength": 1}
      }
    }
  }
}
