{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "i20_scene_review.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "package_id", "fixture_sha256", "status", "reviewer_pseudonym", "reviewed_at_utc", "records"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "contract_version": {"const": "i20-scene-review-v1"},
    "package_id": {"pattern": "^i20-scene-review-sha256-[0-9a-f]{64}$"},
    "fixture_sha256": {"pattern": "^[0-9a-f]{64}$"},
    "status": {"enum": ["draft", "submitted", "frozen"]},
    "reviewer_pseudonym": {"type": "string", "minLength": 1},
    "reviewed_at_utc": {"type": "string", "format": "date-time"},
    "records": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["pair_id", "left_observation_id", "right_observation_id", "same_scene", "distinctive_objects_shared", "field_of_view_overlap", "same_place_different_frame", "decision", "notes_es"],
        "properties": {
          "pair_id": {"pattern": "^scene-pair-sha256-[0-9a-f]{64}$"},
          "left_observation_id": {"pattern": "^I(?:0[1-9]|1[0-9]|20)$"},
          "right_observation_id": {"pattern": "^I(?:0[1-9]|1[0-9]|20)$"},
          "same_scene": {"enum": ["yes", "no", "uncertain"]},
          "distinctive_objects_shared": {"enum": ["yes", "no", "uncertain"]},
          "field_of_view_overlap": {"enum": ["yes", "no", "uncertain"]},
          "same_place_different_frame": {"enum": ["yes", "no", "uncertain"]},
          "decision": {"enum": ["CLEAR", "EXCLUDE", "REVIEW"]},
          "notes_es": {"type": "string", "maxLength": 500}
        }
      }
    }
  }
}
