{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "atlas_experimental_retrieval_response.schema.json",
  "title": "Atlas experimental retrieval response v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "query", "processing", "model", "retrievals", "visual_postprocessing", "timings_ms"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "contract_version": {"const": "atlas-experimental-retrieval-response-v3"},
    "query": {"type": "object"},
    "processing": {"type": "object", "additionalProperties": false, "required": ["mode", "variant", "effective_query", "transformer"], "properties": {"mode": {"enum": ["no_llm", "with_llm"]}, "variant": {"enum": ["es_original", "en_cartographic"]}, "effective_query": {"type": "object"}, "transformer": {"type": ["object", "null"]}}},
    "model": {"type": "object"},
    "retrievals": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "object"}},
    "visual_postprocessing": {"type": "object", "additionalProperties": false, "required": ["status", "source", "request_id", "reason", "model", "policy_id", "baseline_results", "final_results", "evidence"], "properties": {"status": {"enum": ["applied", "fallback_baseline", "disabled"]}, "source": {"enum": ["precomputed", "none"]}, "request_id": {"type": ["string", "null"]}, "reason": {"type": ["string", "null"]}, "model": {"type": ["object", "null"]}, "policy_id": {"type": ["string", "null"]}, "baseline_results": {"type": "array"}, "final_results": {"type": "array"}, "evidence": {"type": "array"}}},
    "timings_ms": {"type": "object", "additionalProperties": false, "required": ["transformation", "text_encoding", "ranking_by_gallery", "total"], "properties": {"transformation": {"type": "number", "minimum": 0}, "text_encoding": {"type": "number", "minimum": 0}, "ranking_by_gallery": {"type": "object"}, "total": {"type": "number", "minimum": 0}}}
  }
}
