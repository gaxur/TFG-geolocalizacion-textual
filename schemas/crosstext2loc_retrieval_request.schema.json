{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "crosstext2loc_retrieval_request.schema.json",
  "title": "Resident CrossText2Loc retrieval request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "query", "gallery_ids", "top_k"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "contract_version": {"const": "crosstext2loc-retrieval-request-v1"},
    "query": {
      "type": "object", "additionalProperties": false,
      "required": ["query_id", "text", "language"],
      "properties": {
        "query_id": {"type": "string", "minLength": 1},
        "text": {"type": "string", "minLength": 1},
        "language": {"type": "string", "minLength": 2}
      }
    },
    "gallery_ids": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "top_k": {"type": "integer", "minimum": 1, "maximum": 1115}
  }
}
